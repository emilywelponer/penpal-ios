rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function canReadPublishedIssue(issueId) {
      // Keep margin-note reads tied to an existing published issue. The
      // publishedIssues read rule currently allows all signed-in users.
      return signedIn()
        && exists(/databases/$(database)/documents/publishedIssues/$(issueId));
    }

    function marginNoteIdMatches(noteId, data) {
      return data.magazineID is string
        && data.pageIndex is int
        && noteId.matches("^" + data.magazineID + "_[0-9]+_" + request.auth.uid + "$");
    }

    function hasValidMarginNoteShape(data, noteId) {
      return data.keys().hasOnly([
          "noteID",
          "magazineID",
          "pageIndex",
          "authorID",
          "authorName",
          "authorUsername",
          "authorDisplayName",
          "authorPhotoURL",
          "createdAt",
          "updatedAt",
          "text"
        ])
        && data.keys().hasAll([
          "noteID",
          "magazineID",
          "pageIndex",
          "authorID",
          "createdAt",
          "updatedAt",
          "text"
        ])
        && data.noteID == noteId
        && data.authorID == request.auth.uid
        && marginNoteIdMatches(noteId, data)
        && data.pageIndex >= 0
        && data.text is string
        && data.text.size() <= 250
        && (!("authorName" in data) || data.authorName is string)
        && (!("authorUsername" in data) || data.authorUsername is string)
        && (!("authorDisplayName" in data) || data.authorDisplayName is string)
        && (!("authorPhotoURL" in data) || data.authorPhotoURL is string)
        && canReadPublishedIssue(data.magazineID);
    }

    function existingViewedBy() {
      return resource.data.viewedBy is list ? resource.data.viewedBy : [];
    }

    match /groups/{groupId} {
      allow read, write: if request.auth != null;
    }

    match /users/{userId} {
      // The owner can always read their own profile. Other signed-in users
      // retain profile reads because friends and group member lists use them.
      allow read: if request.auth != null;
      allow create, delete: if request.auth != null
        && request.auth.uid == userId;
      allow update: if request.auth != null
        && (
          request.auth.uid == userId
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(["friends"])
            && (
              request.auth.uid in request.resource.data.friends
              || request.auth.uid in resource.data.friends
            )
          )
        );

      match /fcmTokens/{tokenId} {
        allow read, create, update, delete: if request.auth != null
          && request.auth.uid == userId;
      }
    }

    match /friendRequests/{requestId} {
      allow get: if request.auth != null
        && (
          requestId.matches(request.auth.uid + "_.*")
          || requestId.matches(".*_" + request.auth.uid)
          || (
            resource.data.toUserID == request.auth.uid
            || resource.data.fromUserID == request.auth.uid
          )
        );

      allow list: if request.auth != null
        && (
          resource.data.toUserID == request.auth.uid
          || resource.data.fromUserID == request.auth.uid
        );

      allow create: if request.auth != null
        && requestId == request.resource.data.fromUserID + "_" + request.resource.data.toUserID
        && request.resource.data.id == requestId
        && request.resource.data.fromUserID == request.auth.uid
        && request.resource.data.toUserID is string
        && request.resource.data.toUserID != request.auth.uid
        && request.resource.data.status == "pending"
        && request.resource.data.keys().hasOnly([
          "id",
          "fromUserID",
          "fromUsername",
          "fromDisplayName",
          "toUserID",
          "toUsername",
          "status",
          "createdAt"
        ]);

      allow update: if request.auth != null
        && resource.data.toUserID == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status"])
        && request.resource.data.status in ["accepted", "declined"];

      allow delete: if request.auth != null
        && (
          resource.data.toUserID == request.auth.uid
          || resource.data.fromUserID == request.auth.uid
        );
    }

    match /issueDrafts/{draftId} {
      allow create: if request.auth != null
        && request.resource.data.ownerID == request.auth.uid;
      allow read, update, delete: if request.auth != null
        && resource.data.ownerID == request.auth.uid;
    }

    match /publishedIssues/{issueId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.ownerID == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.ownerID == request.auth.uid;
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["viewedBy"])
        && request.resource.data.viewedBy is list
        && request.resource.data.viewedBy.hasAll(existingViewedBy())
        && request.auth.uid in request.resource.data.viewedBy;
      allow delete: if request.auth != null
        && resource.data.ownerID == request.auth.uid;
    }

    // MARK: Margin Notes Feature
    match /MarginNotes/{noteId} {
      allow read: if signedIn()
        && resource.data.magazineID is string
        && canReadPublishedIssue(resource.data.magazineID);

      allow create: if signedIn()
        && hasValidMarginNoteShape(request.resource.data, noteId);

      allow update: if signedIn()
        && resource.data.authorID == request.auth.uid
        && resource.data.noteID == noteId
        && marginNoteIdMatches(noteId, resource.data)
        && hasValidMarginNoteShape(request.resource.data, noteId)
        && request.resource.data.authorID == resource.data.authorID
        && request.resource.data.magazineID == resource.data.magazineID
        && request.resource.data.pageIndex == resource.data.pageIndex
        && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if signedIn()
        && resource.data.authorID == request.auth.uid
        && resource.data.noteID == noteId
        && marginNoteIdMatches(noteId, resource.data);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
